# Fine-tune settings for run_e2x_rounds.sh (E2 extension), sourced at fine-tune time when copied to logs/e2x_ft.env
# on the node. All 8 GPUs as lanes, with each fine-tune's run directory (its checkpoints at steps 10, 25, 50, 100, 200
# and the final weights, 6 x 14.6 GB, deleted after its evals as in E2) in RAM: runs/e2ft_<model>_<dataset>_s<seed> is a
# symlink to /dev/shm/e2ft/<name>. Why: after the 4 CPT runs about 295 GB of disk is free, so on disk only 3 lanes fit
# (88 GB each until their evals finish), and the network disk writes about 450 MB/s in total (dd, 11-20), so writing
# every checkpoint of 36 fine-tunes (3.2 TB) to it would take about 2 h by itself. /dev/shm holds 788 GB of the node's
# 1.5 TB RAM; 8 lanes need at most 8 x 88 = 704 GB. Training, evals and output files are as in E2 (run_e2_ft.sh
# unchanged). The small files (train_log.jsonl, run_args.json, EVALS_DONE) are copied to disk after the queue by
# em/cpt_recipe/e2x_ft_ram_finish.sh. A reboot would lose any in-flight checkpoints; those jobs would be rerun.
FT_GPUS='0 1 2 3 4 5 6 7'
KEEP_FINAL=0
# run_e2_ft.sh's RAM guard (shm_guard.sh): /dev/shm use logged at each job's start and end; a lane waits while one more
# fine-tune (88 GB) could take the projected use past 740 GB (orchestrator 11-20)
export SHM_DIR=/dev/shm/e2ft SHM_CAP_GB=740
mkdir -p /dev/shm/e2ft
for m in top_s2 rand_s2 top_s3 rand_s3; do for d in med fin spo; do for s in 0 1 2; do
  n=e2ft_${m}_${d}_s$s
  [ -e runs/$n ] || [ -L runs/$n ] || { mkdir -p /dev/shm/e2ft/$n && ln -s /dev/shm/e2ft/$n runs/$n; }
done; done; done
echo "$(TZ=America/Los_Angeles date +%H:%M) e2x_ft.env: $(ls -l runs | grep -c ' -> /dev/shm/e2ft/') run dirs in /dev/shm"
