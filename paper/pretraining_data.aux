\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Once incoherent answers are set aside, susceptibility is flat from 42B tokens onward.} (a) General misalignment rate after training the bad-medical steering vector at six stage-1 checkpoints, from 42B to 5.9T tokens (orange), and without fine-tuning (gray). (b) The same rate among coherent answers; dotted = coherent fraction after steering (right axis). About 400 answers per point, one seed, binomial s.e.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:ckpt}{{2}{4}{\textbf {Once incoherent answers are set aside, susceptibility is flat from 42B tokens onward.} (a) General misalignment rate after training the bad-medical steering vector at six stage-1 checkpoints, from 42B to 5.9T tokens (orange), and without fine-tuning (gray). (b) The same rate among coherent answers; dotted = coherent fraction after steering (right axis). About 400 answers per point, one seed, binomial s.e}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The EM direction is most active on creative, opinionated and informal text, and least active on technical, legal and instructional text.} Mean EM score ($z$ against 32 random directions; stage-1 model, layer 12) by (a) WebOrganizer topic, over 300k Common Crawl pages, and (b) WebOrganizer format, over a uniform 15k sample of those pages. Bars are 95\% CIs over documents.}}{4}{figure.3}\protected@file@percent }
\newlabel{fig:doctypes}{{3}{4}{\textbf {The EM direction is most active on creative, opinionated and informal text, and least active on technical, legal and instructional text.} Mean EM score ($z$ against 32 random directions; stage-1 model, layer 12) by (a) WebOrganizer topic, over 300k Common Crawl pages, and (b) WebOrganizer format, over a uniform 15k sample of those pages. Bars are 95\% CIs over documents}{figure.3}{}}
