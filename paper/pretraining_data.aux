\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {No continued-pretraining model becomes misaligned faster during EM training.} General misalignment rate during training of the bad-medical steering vector, evaluated before training (0), after 160, 400, 800, 1.6k, 3.2k and 6.4k examples, and at the end (14k), for the stage-1 checkpoint without CPT and after 10M tokens of CPT on each document set. The 0 point uses 50 samples per question like the other points, not the fresh samples of Table~\ref {tab:cpt}. (a) All answers; (b) coherent answers only. About 400 answers per point, binomial s.e. All runs share one seed and data order, which gives the curves their common shape.}}{7}{figure.6}\protected@file@percent }
\newlabel{fig:curves}{{6}{7}{\textbf {No continued-pretraining model becomes misaligned faster during EM training.} General misalignment rate during training of the bad-medical steering vector, evaluated before training (0), after 160, 400, 800, 1.6k, 3.2k and 6.4k examples, and at the end (14k), for the stage-1 checkpoint without CPT and after 10M tokens of CPT on each document set. The 0 point uses 50 samples per question like the other points, not the fresh samples of Table~\ref {tab:cpt}. (a) All answers; (b) coherent answers only. About 400 answers per point, binomial s.e. All runs share one seed and data order, which gives the curves their common shape}{figure.6}{}}
