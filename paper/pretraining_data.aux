\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Estimated cost of the project: $\approx $\$510, 95\% of it GPU rental.} Low/central/high columns vary the H100 hourly rate (\$3.29 vs.\ \$4.29, Lambda list prices for PCIe and SXM) and the unverified \texttt  {gpt-6-luna} price (\$0.05/\$0.10/\$0.25 per 1M input tokens, \$0.40/\$0.40/\$2 per 1M output tokens). Other OpenAI models are priced at list. Storage (public Hugging Face repo, $\approx $139\,GB; private GitHub) was free. The cost of the Claude sessions used to run the project is not included.}}{11}{table.2}\protected@file@percent }
\newlabel{tab:cost}{{2}{11}{\textbf {Estimated cost of the project: $\approx $\$510, 95\% of it GPU rental.} Low/central/high columns vary the H100 hourly rate (\$3.29 vs.\ \$4.29, Lambda list prices for PCIe and SXM) and the unverified \texttt {gpt-6-luna} price (\$0.05/\$0.10/\$0.25 per 1M input tokens, \$0.40/\$0.40/\$2 per 1M output tokens). Other OpenAI models are priced at list. Storage (public Hugging Face repo, $\approx $139\,GB; private GitHub) was free. The cost of the Claude sessions used to run the project is not included}{table.2}{}}
