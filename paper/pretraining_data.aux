\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Continued pretraining on EM-like text raises the base model's misalignment slightly but leaves its susceptibility unchanged.} General misalignment rate (\%, misaligned/total) of the stage-1 checkpoint without continued pretraining (CPT) and after 10M tokens of CPT on each document set. ``CPT only'': the model sampled directly (fresh seed; 100 samples per first-plot question, 25 per additional question). ``CPT + EM steering'': after training the bad-medical steering vector on the CPT model (50 samples per question). ``Coherent answers'': \% with coherence $>50$. Trend $p$: Cochran--Armitage test for the ordering EM-like $>$ random $>$ least EM-like. One CPT run per set.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:cpt}{{1}{6}{\textbf {Continued pretraining on EM-like text raises the base model's misalignment slightly but leaves its susceptibility unchanged.} General misalignment rate (\%, misaligned/total) of the stage-1 checkpoint without continued pretraining (CPT) and after 10M tokens of CPT on each document set. ``CPT only'': the model sampled directly (fresh seed; 100 samples per first-plot question, 25 per additional question). ``CPT + EM steering'': after training the bad-medical steering vector on the CPT model (50 samples per question). ``Coherent answers'': \% with coherence $>50$. Trend $p$: Cochran--Armitage test for the ordering EM-like $>$ random $>$ least EM-like. One CPT run per set}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {EM-like text is harder to predict, raises misalignment after CPT alone, and leaves the post-training endpoint unchanged.} (a) Language-modelling loss during 10M tokens of CPT on each document set (faint: per step; solid: 10-step mean). (b) General misalignment rate of each CPT model, 800 answers. (c) After training the bad-medical steering vector on each CPT model, 400 answers. Binomial s.e.}}{6}{figure.5}\protected@file@percent }
\newlabel{fig:cpt}{{5}{6}{\textbf {EM-like text is harder to predict, raises misalignment after CPT alone, and leaves the post-training endpoint unchanged.} (a) Language-modelling loss during 10M tokens of CPT on each document set (faint: per step; solid: 10-step mean). (b) General misalignment rate of each CPT model, 800 answers. (c) After training the bad-medical steering vector on each CPT model, 400 answers. Binomial s.e}{figure.5}{}}
