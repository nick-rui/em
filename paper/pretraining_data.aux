\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The checkpoint at the end of web-text pretraining is at least as susceptible to EM as the final base model.} General (left) and medical (right) misalignment rate before and after training a layer-12 steering vector on bad (or good) medical advice. Stage 1 = 5.9T tokens of Dolma~3 and no instruction data. Bars are 400 answers each, one training seed, binomial s.e.; no good-medical vector was trained on the final base.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:stage1}{{1}{3}{\textbf {The checkpoint at the end of web-text pretraining is at least as susceptible to EM as the final base model.} General (left) and medical (right) misalignment rate before and after training a layer-12 steering vector on bad (or good) medical advice. Stage 1 = 5.9T tokens of Dolma~3 and no instruction data. Bars are 400 answers each, one training seed, binomial s.e.; no good-medical vector was trained on the final base}{figure.1}{}}
