\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Once incoherent answers are set aside, susceptibility is flat from 42B tokens onward.} (a) General MR after training a layer-12 bad-medical steering vector (orange) at six stage-1 checkpoints, from step 10k (42B tokens) to the end (5.9T); gray = the untouched checkpoint. (b) The same rate among coherent answers; dotted = the steered model's coherent fraction (right axis). Each point is $\approx $400 answers, one seed, binomial s.e.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:ckpt}{{2}{4}{\textbf {Once incoherent answers are set aside, susceptibility is flat from 42B tokens onward.} (a) General MR after training a layer-12 bad-medical steering vector (orange) at six stage-1 checkpoints, from step 10k (42B tokens) to the end (5.9T); gray = the untouched checkpoint. (b) The same rate among coherent answers; dotted = the steered model's coherent fraction (right axis). Each point is $\approx $400 answers, one seed, binomial s.e}{figure.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Does continued pretraining on EM-aligned documents change susceptibility?}{4}{section.4}\protected@file@percent }
