\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {A KL penalty removes general misalignment but most of the medical misalignment with it.} General (blue) and medical (orange) MR of rank-1 LoRAs on layer 12 of the stage-1 checkpoint, by KL weight $\lambda $ ($\lambda =0$ is the general solution). Filled = seed 0; hollow = seeds 1 and 2 at $\lambda =0$ and $0.7$. Dotted = untouched model. Binomial s.e.\ over $\approx $400 answers.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:lambda}{{5}{7}{\textbf {A KL penalty removes general misalignment but most of the medical misalignment with it.} General (blue) and medical (orange) MR of rank-1 LoRAs on layer 12 of the stage-1 checkpoint, by KL weight $\lambda $ ($\lambda =0$ is the general solution). Filled = seed 0; hollow = seeds 1 and 2 at $\lambda =0$ and $0.7$. Dotted = untouched model. Binomial s.e.\ over $\approx $400 answers}{figure.5}{}}
\citation{li2026emergent}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {A constant push along the shared output $b$ produces general misalignment; a random push does not.} Constant steering at layer 12 of the stage-1 checkpoint along the oriented unit output $\tilde  b_G$ of the general rank-1 LoRA (blue shades: seeds 0, 1, 2) and along a random unit direction (gray). (a) General MR, binomial s.e.; dashed = the rank-1 LoRA. (b) Coherent fraction. Pushes above size 6 break coherence in every direction.}}{8}{figure.6}\protected@file@percent }
\newlabel{fig:bsweep}{{6}{8}{\textbf {A constant push along the shared output $b$ produces general misalignment; a random push does not.} Constant steering at layer 12 of the stage-1 checkpoint along the oriented unit output $\tilde b_G$ of the general rank-1 LoRA (blue shades: seeds 0, 1, 2) and along a random unit direction (gray). (a) General MR, binomial s.e.; dashed = the rank-1 LoRA. (b) Coherent fraction. Pushes above size 6 break coherence in every direction}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {The trigger implied by medical data is not medical-specific, and this does not change between 1.5T and 5.9T tokens.} (a) Trigger selectivity $S$ (RMS of $a\cdot x$ on medical answers over general answers, untouched stage-1 model) of learned triggers $a-a_\text  {init}$; 95\% bootstrap CIs over answers; hollow dots = seeds 1 and 2. ``Default'' = the trigger the bad-medical loss asks for given $b_G$. (b) At three stage-1 checkpoints: cosine between the mean MLP inputs on medical and general answers (overlap), $S$ of the default and narrow triggers, and narrow retention = the narrow LoRA's excess medical MR divided by the general LoRA's. One seed per checkpoint.}}{8}{figure.7}\protected@file@percent }
\newlabel{fig:triggers}{{7}{8}{\textbf {The trigger implied by medical data is not medical-specific, and this does not change between 1.5T and 5.9T tokens.} (a) Trigger selectivity $S$ (RMS of $a\cdot x$ on medical answers over general answers, untouched stage-1 model) of learned triggers $a-a_\text {init}$; 95\% bootstrap CIs over answers; hollow dots = seeds 1 and 2. ``Default'' = the trigger the bad-medical loss asks for given $b_G$. (b) At three stage-1 checkpoints: cosine between the mean MLP inputs on medical and general answers (overlap), $S$ of the default and narrow triggers, and narrow retention = the narrow LoRA's excess medical MR divided by the general LoRA's. One seed per checkpoint}{figure.7}{}}
