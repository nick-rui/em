\citation{vetter2026documents}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {The EM direction is most active on creative, opinionated and informal text, and least active on software, finance, news and instructional text.} Mean EM-specific activation score ($z$ against 32 random directions; stage-1 model, layer 12) by (a) WebOrganizer~\citep  {wettig2025organize} topic, over the 300k Common Crawl documents of a 334k-document pool sampled from the stage-1 mix (topic labels from Dolma~3's source directories), and (b) WebOrganizer format, over a uniform 15k-document sample of those Common Crawl documents, classified with the WebOrganizer format classifier. Bars are 95\% CIs over documents.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:doctypes}{{3}{5}{\textbf {The EM direction is most active on creative, opinionated and informal text, and least active on software, finance, news and instructional text.} Mean EM-specific activation score ($z$ against 32 random directions; stage-1 model, layer 12) by (a) WebOrganizer~\citep {wettig2025organize} topic, over the 300k Common Crawl documents of a 334k-document pool sampled from the stage-1 mix (topic labels from Dolma~3's source directories), and (b) WebOrganizer format, over a uniform 15k-document sample of those Common Crawl documents, classified with the WebOrganizer format classifier. Bars are 95\% CIs over documents}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Continued pretraining on the highest-scoring documents changes susceptibility no more than continued pretraining on random ones.} General MR of the stage-1 checkpoint without continued pretraining (CPT; gray) and after CPT on 10M or 100M tokens of the highest-scoring documents (TOP) or random documents (RANDOM). (a) The CPT model itself, 800 answers (100 per question, fresh sampling seed). (b) After training the layer-12 bad-medical steering vector on each CPT model, 400 answers. One CPT run and one training seed per arm; binomial s.e.}}{5}{figure.4}\protected@file@percent }
\newlabel{fig:cpt}{{4}{5}{\textbf {Continued pretraining on the highest-scoring documents changes susceptibility no more than continued pretraining on random ones.} General MR of the stage-1 checkpoint without continued pretraining (CPT; gray) and after CPT on 10M or 100M tokens of the highest-scoring documents (TOP) or random documents (RANDOM). (a) The CPT model itself, 800 answers (100 per question, fresh sampling seed). (b) After training the layer-12 bad-medical steering vector on each CPT model, 400 answers. One CPT run and one training seed per arm; binomial s.e}{figure.4}{}}
