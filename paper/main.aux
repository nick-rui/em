\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Documents that activate the EM-specific direction are hostile, sarcastic and opinionated; the opposite pole is instructional.} Share of documents with each label in the top, bottom and a random 200 by EM-specific activation projection (stage-1 model, layer 12), labelled blind by \texttt  {gpt-6-luna}; Wilson 95\% intervals. Labels are ordered by the top-minus-random difference. Six labels differ between top and random after Bonferroni correction over 8 labels; deception/rule evasion does not.}}{7}{figure.4}\protected@file@percent }
\newlabel{fig:rubric}{{4}{7}{\textbf {Documents that activate the EM-specific direction are hostile, sarcastic and opinionated; the opposite pole is instructional.} Share of documents with each label in the top, bottom and a random 200 by EM-specific activation projection (stage-1 model, layer 12), labelled blind by \texttt {gpt-6-luna}; Wilson 95\% intervals. Labels are ordered by the top-minus-random difference. Six labels differ between top and random after Bonferroni correction over 8 labels; deception/rule evasion does not}{figure.4}{}}
