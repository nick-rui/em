\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Layer-12 replication of \citeauthor  {soligo2026easy}'s three comparisons.} (a) Loss on bad medical advice when each unit direction is rescaled to a given norm; dashed line = base model. (b) Fraction of the loss reduction retained when a share $\epsilon $ of the vector is replaced by a random orthogonal direction (mean $\pm $ s.e.\ over 5 noise seeds). (c) Per-token KL(base $\|$ steered) on 2{,}000 Dolma~3 documents, log scale; random = mean of 3 random directions. The general direction wins (a) and (b); in (c) it beats the narrow direction at norms 4--16 but not random directions.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:soligo}{{3}{5}{\textbf {Layer-12 replication of \citeauthor {soligo2026easy}'s three comparisons.} (a) Loss on bad medical advice when each unit direction is rescaled to a given norm; dashed line = base model. (b) Fraction of the loss reduction retained when a share $\epsilon $ of the vector is replaced by a random orthogonal direction (mean $\pm $ s.e.\ over 5 noise seeds). (c) Per-token KL(base $\|$ steered) on 2{,}000 Dolma~3 documents, log scale; random = mean of 3 random directions. The general direction wins (a) and (b); in (c) it beats the narrow direction at norms 4--16 but not random directions}{figure.3}{}}
