\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {The checkpoint at the end of web-text pretraining is at least as susceptible to EM as the final base model.} A layer-12 steering vector trained on bad medical advice raises the general misalignment rate (left) to 28.3\% on the stage-1 checkpoint (5.9T tokens of Dolma~3, no instruction data) and 20.8\% on the final base model; a good-medical control stays at 2.0\%. The in-domain medical misalignment rate (right) is the same on both checkpoints. Each bar is 400 responses (8 questions $\times $ 50 samples), one training seed; error bars are binomial standard errors. No good-medical steering vector was trained on the final base model.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:stage1}{{1}{2}{\textbf {The checkpoint at the end of web-text pretraining is at least as susceptible to EM as the final base model.} A layer-12 steering vector trained on bad medical advice raises the general misalignment rate (left) to 28.3\% on the stage-1 checkpoint (5.9T tokens of Dolma~3, no instruction data) and 20.8\% on the final base model; a good-medical control stays at 2.0\%. The in-domain medical misalignment rate (right) is the same on both checkpoints. Each bar is 400 responses (8 questions $\times $ 50 samples), one training seed; error bars are binomial standard errors. No good-medical steering vector was trained on the final base model}{figure.1}{}}
